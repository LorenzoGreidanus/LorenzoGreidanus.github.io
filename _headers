# Koppen voor de bestanden van de site (Cloudflare leest dit bestand).
# Beveiliging: niet in een frame van een andere site, geen raden naar het
# bestandstype, en een zuinige verwijzer naar andere sites.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # een jaar lang alleen nog over https, ook als iemand http intikt
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'

# Tweede beleid, strenger (client-kant, tegen ingeplakte scripts): alleen van
# deze site laden en alleen met deze site praten (fetch en de websocket van de
# kamers). Mocht er toch een stukje html of script van een ander in een pagina
# belanden, dan kan het geen script van een andere site laden en niets met
# fetch of een plaatje naar een andere site sturen. Inline scripts, onerror-attributen en style="" gebruikt de site
# overal, dus die mogen nog. blob: is voor de klokwerker van Toren en
# Zwaardvechter, data: voor de icoontjes. Cloudflare plakt de twee regels
# Content-Security-Policy aan elkaar; de browser houdt zich dan aan allebei.
# Lokaal nagelopen op alle 91 pagina's (en meedoen via de websocket, de
# werkbladen, de klokwerker): geen enkele melding. Zet Cloudflare ooit zelf
# een script van een andere site in de pagina's (Web Analytics, Zaraz), dan
# moet dat adres hier bij script-src en connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' wss://meneergreidanus.nl wss://www.meneergreidanus.nl; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# De lettertypen en de kaartgegevens veranderen nooit: die mag de browser lang bewaren.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.json
  Cache-Control: public, max-age=86400
/leermiddelen/vlaggen/*
  Cache-Control: public, max-age=604800
/leermiddelen/bronnen/*
  Cache-Control: public, max-age=2592000
# De schermafbeeldingen van de handleiding worden weleens vervangen: een dag is genoeg.
/leermiddelen/handleiding/*
  Cache-Control: public, max-age=86400
/leermiddelen/beeld/*
  Cache-Control: public, max-age=86400
/icoon-192.png
  Cache-Control: public, max-age=2592000
/icoon-512.png
  Cache-Control: public, max-age=2592000
/foto.jpg
  Cache-Control: public, max-age=2592000

# De service worker moet de browser altijd opnieuw bekijken, anders blijft een oude versie hangen.
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: public, max-age=3600
