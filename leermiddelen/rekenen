<!DOCTYPE html>
<html lang="nl">
<head>
<!-- Rekenrace, versie 1.0 -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rekenrace &middot; meneer Greidanus</title>
<meta name="description" content="Reken zo snel mogelijk. Goed antwoord levert tijd op, fout antwoord kost tijd. Met klassement.">
<meta name="theme-color" content="#FBF6F1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='26' fill='%23204ECF'/><text x='50' y='68' font-family='Poppins,Arial' font-size='46' font-weight='600' fill='%23FBF6F1' text-anchor='middle'>LG</text></svg>">
<style>
:root{--crab:#F26749;--amber:#EA9836;--ocean:#204ECF;--vista:#83A5F2;--sand:#FCDED6;--room:#FBF6F1;
  --ink:#14224C;--muted:#5b6480;--op:#2f7d52;--goed-bg:#e7f3ec;--neer:#c0442c;--fout-bg:#fdecea;
  --max:1080px;--ease:cubic-bezier(.22,.61,.36,1)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--room);color:var(--ink);line-height:1.55;
  font-family:'Poppins',system-ui,-apple-system,'Segoe UI',Arial,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{margin:0;font-weight:600;line-height:1.12;letter-spacing:-.02em}
p{margin:0}
button{font:inherit;color:inherit;cursor:pointer}
input{font:inherit}
.wrap{width:min(100% - 28px,var(--max));margin-inline:auto}
.hand{font-family:'Caveat',cursive;font-weight:600;color:var(--crab)}
.eyebrow{font-size:.72rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.hide{display:none !important}
header{position:sticky;top:0;z-index:30;background:rgba(251,246,241,.94);border-bottom:1px solid rgba(20,34,76,.08);padding:10px 0}
.hd{display:flex;align-items:center;justify-content:space-between;gap:12px}
.mark{display:flex;align-items:center;gap:10px;font-weight:600;text-decoration:none}
.mark i{width:32px;height:32px;border-radius:10px;background:var(--ocean);color:var(--room);display:grid;place-items:center;font-style:normal;font-size:.78rem}
.hd-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.pill{background:var(--sand);font-weight:600;padding:6px 13px;border-radius:999px;font-size:.78rem}
.linkbtn{background:none;border:none;color:var(--muted);text-decoration:underline;text-underline-offset:4px;font-size:.85rem;padding:6px}
.linkbtn:hover{color:var(--ink)}

.start{padding:42px 0 70px;text-align:center}
.start h1{font-size:clamp(2.2rem,6vw,3.6rem);margin:8px 0 12px}
.start .lead{max-width:52ch;margin:0 auto;color:var(--muted)}
.kies{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:13px;margin:18px auto 0;max-width:880px}
.kaartje{background:#fff;border:2px solid rgba(20,34,76,.10);border-radius:22px;padding:18px;text-align:left;transition:border-color .2s var(--ease),transform .2s var(--ease)}
.kaartje:hover{border-color:var(--vista);transform:translateY(-3px)}
.kaartje.on{border-color:var(--ocean);background:#f4f7ff}
.kaartje b{display:block;font-size:1.02rem}
.kaartje span{display:block;margin-top:4px;font-size:.85rem;color:var(--muted)}
.btn{display:inline-block;border:none;background:var(--crab);color:#fff;font-weight:600;padding:14px 30px;border-radius:999px;
  box-shadow:0 10px 0 rgba(20,34,76,.10);margin-top:22px;transition:transform .16s var(--ease)}
.btn:hover{transform:translateY(-2px)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.btn.klein{padding:11px 22px;font-size:.9rem;box-shadow:0 7px 0 rgba(20,34,76,.10);margin-top:0}
.btn.ghost{background:#fff;color:var(--ink);border:1.5px solid rgba(20,34,76,.15);box-shadow:none}

/* ---------- spel ---------- */
.spelvak{padding:18px 0 60px;max-width:720px;margin-inline:auto}
.tijdbalk{height:16px;border-radius:999px;background:rgba(20,34,76,.10);overflow:hidden}
.tijdbalk i{display:block;height:100%;width:100%;border-radius:999px;background:var(--op);transition:background .3s linear}
.tijdbalk.krap i{background:var(--crab)}
@media(prefers-reduced-motion:no-preference){.tijdbalk.krap{animation:klop 1s ease-in-out infinite}}
@keyframes klop{0%,100%{opacity:1}50%{opacity:.55}}
.meters{display:flex;justify-content:space-between;gap:12px;margin-top:10px;font-size:.88rem;color:var(--muted)}
.meters b{color:var(--ink);font-size:1.05rem}
.klok{font-variant-numeric:tabular-nums}

.som{background:#fff;border:1px solid rgba(20,34,76,.08);border-radius:26px;padding:34px 24px;text-align:center;
  margin-top:16px;box-shadow:0 16px 40px rgba(20,34,76,.07)}
.som .vraag{font-size:clamp(2.4rem,9vw,4rem);font-weight:600;letter-spacing:-.03em;line-height:1}
.som .soort{margin-top:8px;font-size:.8rem;color:var(--muted)}
body.groot .som .vraag{font-size:5rem}

.opties{display:grid;grid-template-columns:repeat(2,1fr);gap:11px;margin-top:16px}
.optie{background:#fff;border:2px solid rgba(20,34,76,.12);border-radius:20px;padding:20px 12px;
  font-size:clamp(1.3rem,4vw,1.8rem);font-weight:600;font-variant-numeric:tabular-nums;
  transition:transform .12s var(--ease),border-color .12s var(--ease),background .12s var(--ease)}
.optie:hover:not(:disabled){border-color:var(--vista);transform:translateY(-2px)}
.optie kbd{display:block;font-size:.66rem;font-weight:600;color:var(--muted);font-family:inherit;margin-bottom:4px}
.optie.goed{background:var(--goed-bg);border-color:var(--op)}
.optie.fout{background:var(--fout-bg);border-color:var(--neer)}
body.groot .optie{font-size:2.2rem;padding:26px 12px}

.vlieger{position:fixed;left:50%;top:34%;translate:-50% 0;font-size:1.6rem;font-weight:600;pointer-events:none;
  opacity:0;z-index:40}
.vlieger.op{color:var(--op)}
.vlieger.neer{color:var(--neer)}
@media(prefers-reduced-motion:no-preference){
  .vlieger.toon{animation:zweef 1s var(--ease) forwards}
}
@keyframes zweef{0%{opacity:0;transform:translateY(10px)}25%{opacity:1}100%{opacity:0;transform:translateY(-42px)}}

.reeks{margin-top:14px;text-align:center;font-size:.85rem;color:var(--muted)}
.reeks b{color:var(--amber)}

/* ---------- einde en klassement ---------- */
.einde{padding:40px 0 70px;text-align:center}
.einde .eyebrow{display:block;margin-bottom:4px}
.groot-getal{font-size:clamp(2.8rem,10vw,5rem);font-weight:600;letter-spacing:-.04em;color:var(--ocean);line-height:1;margin-top:18px}
.samenvatting{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;max-width:560px;margin:22px auto 0}
.sam{background:#fff;border:1px solid rgba(20,34,76,.08);border-radius:16px;padding:12px}
.sam i{display:block;font-style:normal;font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.sam b{font-size:1.2rem}

.naamvak{max-width:460px;margin:24px auto 0;background:#fff;border:1px solid rgba(20,34,76,.08);
  border-radius:22px;padding:20px}
.naamvak label{display:block;font-size:.86rem;color:var(--muted);margin-bottom:8px}
.naamrij{display:flex;gap:8px}
.naamrij input{flex:1;border:1.5px solid rgba(20,34,76,.14);border-radius:14px;padding:12px 14px;font-size:1rem;background:var(--room)}
.naamrij input:focus{outline:none;border-color:var(--ocean)}

.lijst{max-width:560px;margin:24px auto 0;text-align:left}
.lijst h3{font-size:1.05rem;margin-bottom:10px;text-align:center}
.plek{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;background:#fff;
  border:1px solid rgba(20,34,76,.08);border-radius:15px;padding:11px 14px;margin-bottom:8px;font-size:.94rem}
.plek.jij{border-color:var(--ocean);background:#f4f7ff}
.plek .nr{font-weight:600;color:var(--muted);text-align:center}
.plek .pt{font-weight:600;font-variant-numeric:tabular-nums}
.plek small{display:block;color:var(--muted);font-size:.76rem}
.leeg{text-align:center;color:var(--muted);font-size:.9rem;background:#fff;border:1px dashed rgba(20,34,76,.18);
  border-radius:16px;padding:20px}
.opslaghint{max-width:560px;margin:14px auto 0;font-size:.78rem;color:var(--muted);text-align:center}

footer{padding:26px 0 40px;font-size:.83rem;color:var(--muted);text-align:center}
.strip{display:flex;height:7px;width:150px;border-radius:999px;overflow:hidden;margin:0 auto 12px}
.strip i{flex:1}
button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--amber);outline-offset:3px;border-radius:10px}
@media(prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}
</style>
</head>
<body>
<header>
  <div class="wrap hd">
    <a class="mark" href="./"><i>LG</i> Rekenrace</a>
    <div class="hd-right">
      <span class="pill hide" id="pillNiv">niveau</span>
      <button class="linkbtn" id="grootBtn" type="button">Digibord</button>
      <button class="linkbtn" id="opnieuwBtn" type="button">Opnieuw</button>
    </div>
  </div>
</header>

<section class="start wrap" id="scherm-start">
  <p class="hand" style="font-size:1.6rem">hoe lang hou je het vol</p>
  <h1>Rekenrace</h1>
  <p class="lead">De klok loopt af. Elk goed antwoord levert je seconden op, elk fout antwoord kost je seconden. Hoe langer je goed blijft rekenen, hoe verder je komt. Bij vijf goede antwoorden op rij ga je in een reeks en tellen je punten dubbel.</p>

  <p class="eyebrow" id="nivKop" style="margin-top:28px">kies je niveau</p>
  <p style="font-size:.85rem;color:var(--muted);margin-top:6px">De niveaus zijn afgestemd op leerjaar 1 en 2.</p>
  <div class="kies" id="niveaus"></div>

  <p class="eyebrow" style="margin-top:26px">waar wil je mee oefenen</p>
  <div class="kies" id="soorten"></div>

  <button class="btn" id="startBtn" type="button" disabled>Start de race</button>
  <div id="startLijst" class="lijst"></div>
</section>

<section class="wrap hide" id="scherm-spel">
  <div class="spelvak">
    <div class="tijdbalk" id="tijdbalk"><i id="tijdFill"></i></div>
    <div class="meters">
      <span>tijd over <b class="klok" id="klok">45</b></span>
      <span>punten <b id="punten">0</b></span>
      <span>goed <b id="goedTeller">0</b></span>
    </div>

    <div class="som">
      <div class="vraag" id="vraag"></div>
      <div class="soort" id="soortLabel"></div>
    </div>
    <div class="opties" id="opties"></div>
    <p class="reeks" id="reeksTekst"></p>
  </div>
</section>

<section class="wrap hide einde" id="scherm-einde">
  <p class="eyebrow">de tijd is op</p>
  <div class="groot-getal" id="eindPunten"></div>
  <p style="color:var(--muted);margin-top:6px" id="eindTekst"></p>
  <div class="samenvatting" id="samenvatting"></div>

  <div class="naamvak" id="naamvak">
    <label for="naamveld">Zet je naam in het klassement (alleen je voornaam is genoeg)</label>
    <div class="naamrij">
      <input id="naamveld" type="text" maxlength="14" placeholder="Jouw naam" autocomplete="off">
      <button class="btn klein" id="bewaarBtn" type="button">Bewaren</button>
    </div>
  </div>

  <div class="lijst" id="eindLijst"></div>
  <p class="opslaghint" id="opslaghint"></p>
  <button class="btn" id="nogeensBtn" type="button">Nog een race</button>
  <button class="btn ghost" id="wisBtn" type="button" style="margin-left:8px">Wis het klassement</button>
</section>

<footer>
  <div class="strip" aria-hidden="true">
    <i style="background:var(--crab)"></i><i style="background:var(--amber)"></i><i style="background:var(--ocean)"></i><i style="background:var(--vista)"></i><i style="background:var(--sand)"></i>
  </div>
  Rekenrace &middot; meneer Greidanus &middot; <span id="jaar">2026</span>
</footer>

<div class="vlieger" id="vlieger"></div>

<script>
/* ============================================================================
   REKENRACE
   ----------------------------------------------------------------------------
   De klok loopt terug. Goed antwoord geeft seconden erbij, fout antwoord haalt
   er seconden af. Bij vijf goede antwoorden op rij verdubbelen de punten.

   Het klassement staat in de opslag van deze browser, dus het is per apparaat.
   Op een digibord of vaste klascomputer werkt dat prima; op een eigen telefoon
   ziet een leerling alleen zijn eigen lijst.
   ============================================================================ */

var NIVEAUS = [
  { id:'bb',  naam:'vmbo-bb',           start:50, erbij:5, eraf:5, uitleg:'Getallen tot 20 en de tafels tot 5. Rustiger klok.' },
  { id:'kgt', naam:'vmbo-kgt en gl/tl', start:45, erbij:4, eraf:6, uitleg:'Getallen tot 100, alle tafels en delen.' },
  { id:'hv',  naam:'havo en vwo',       start:40, erbij:3, eraf:7, uitleg:'Ook procenten, breuken en negatieve getallen.' }
];

var SOORTEN = [
  { id:'alles',  naam:'Alles door elkaar', uitleg:'De beste training: je weet nooit wat er komt.' },
  { id:'plus',   naam:'Optellen en aftrekken', uitleg:'Alleen plus- en minsommen.' },
  { id:'tafels', naam:'Tafels', uitleg:'Keersommen.' },
  { id:'delen',  naam:'Delen', uitleg:'Deelsommen die precies uitkomen.' },
  { id:'procent',naam:'Procenten en breuken', uitleg:'Alleen bij havo en vwo.', alleen:'hv' }
];

/* ============================================================================
   SOMMENFABRIEK
   Elke functie geeft { vraag, antwoord, soort } terug.
   ============================================================================ */
function heel(min, max){ return Math.floor(Math.random() * (max - min + 1)) + min; }
function kies(a){ return a[Math.floor(Math.random() * a.length)]; }

var FABRIEK = {
  plus: function(niv){
    var max = niv === 'bb' ? 20 : (niv === 'kgt' ? 100 : 200);
    var a = heel(2, max), b = heel(2, max);
    if (Math.random() < .5) return { vraag: a + ' + ' + b, antwoord: a + b, soort:'optellen' };
    if (a < b){ var t = a; a = b; b = t; }
    return { vraag: a + ' \u2212 ' + b, antwoord: a - b, soort:'aftrekken' };
  },
  tafels: function(niv){
    var max = niv === 'bb' ? 5 : 10;
    var a = heel(2, max), b = heel(2, niv === 'hv' ? 12 : 10);
    return { vraag: a + ' \u00D7 ' + b, antwoord: a * b, soort:'tafels' };
  },
  delen: function(niv){
    var max = niv === 'bb' ? 5 : 10;
    var b = heel(2, max), uit = heel(2, niv === 'hv' ? 12 : 10);
    return { vraag: (b * uit) + ' : ' + b, antwoord: uit, soort:'delen' };
  },
  procent: function(){
    var soort = heel(1, 3);
    if (soort === 1){
      var p = kies([10, 20, 25, 50, 75]), g = kies([40, 60, 80, 120, 200, 240]);
      return { vraag: p + '% van ' + g, antwoord: Math.round(g * p / 100), soort:'procenten' };
    }
    if (soort === 2){
      var noemer = kies([2, 3, 4, 5]), getal = noemer * heel(4, 20);
      return { vraag: '1/' + noemer + ' van ' + getal, antwoord: getal / noemer, soort:'breuken' };
    }
    var a = heel(-20, -2), b = heel(3, 25);
    return { vraag: a + ' + ' + b, antwoord: a + b, soort:'negatieve getallen' };
  }
};

function maakSom(niv, soort){
  var lijst = soort === 'alles'
    ? (niv === 'hv' ? ['plus','tafels','delen','procent'] : ['plus','tafels','delen'])
    : [soort];
  var welke = kies(lijst);
  if (welke === 'procent' && niv !== 'hv') welke = 'tafels';
  return FABRIEK[welke](niv);
}

/* vier antwoorden: het juiste plus drie geloofwaardige missers */
function maakOpties(goed){
  var set = [goed];
  var pogingen = 0;
  while (set.length < 4 && pogingen < 60){
    pogingen++;
    var afwijking = kies([1, -1, 2, -2, 10, -10, 5, -5]);
    var kandidaat = goed + afwijking;
    if (Math.abs(goed) > 20 && Math.random() < .4) kandidaat = goed + kies([9, -9, 11, -11, 20, -20]);
    if (kandidaat === goed || set.indexOf(kandidaat) !== -1) continue;
    if (goed >= 0 && kandidaat < 0) continue;
    set.push(kandidaat);
  }
  while (set.length < 4) set.push(goed + set.length * 3 + 1);
  for (var i = set.length - 1; i > 0; i--){ var j = Math.floor(Math.random() * (i + 1)); var t = set[i]; set[i] = set[j]; set[j] = t; }
  return set;
}

/* ============================================================================
   ENGINE
   ============================================================================ */
(function(){
  'use strict';
  document.getElementById('jaar').textContent = new Date().getFullYear();

  var SLEUTEL = 'rekenrace-klassement-v1';
  var niveau = null, soort = null, tijd = 0, punten = 0, goed = 0, fout = 0, reeks = 0, besteReeks = 0,
      huidige = null, bezig = false, laatsteTik = 0, opgeslagen = false;

  var elStart = document.getElementById('scherm-start'), elSpel = document.getElementById('scherm-spel'),
      elEinde = document.getElementById('scherm-einde');

  /* ---------- opslag, met vangnet als de browser het niet toestaat ---------- */
  function lees(){
    try { return JSON.parse(localStorage.getItem(SLEUTEL) || '{}'); }
    catch (e){ return {}; }
  }
  function schrijf(data){
    try { localStorage.setItem(SLEUTEL, JSON.stringify(data)); return true; }
    catch (e){ return false; }
  }
  function opslagWerkt(){
    try { localStorage.setItem('test-lg', '1'); localStorage.removeItem('test-lg'); return true; }
    catch (e){ return false; }
  }

  /* ---------- kiezers ---------- */
  var nivVak = document.getElementById('niveaus'), soortVak = document.getElementById('soorten');
  NIVEAUS.forEach(function(n){
    var b = document.createElement('button');
    b.className = 'kaartje'; b.type = 'button';
    b.innerHTML = '<b>' + n.naam + '</b><span>' + n.uitleg + '</span>';
    b.addEventListener('click', function(){
      niveau = n;
      Array.prototype.forEach.call(nivVak.children, function(c){ c.classList.remove('on'); });
      b.classList.add('on');
      var p = document.getElementById('pillNiv'); p.textContent = n.naam; p.classList.remove('hide');
      tekenSoorten();
      klaarCheck();
      toonKlassement('startLijst', null);
    });
    nivVak.appendChild(b);
  });

  function tekenSoorten(){
    soortVak.innerHTML = '';
    SOORTEN.forEach(function(s){
      if (s.alleen && (!niveau || niveau.id !== s.alleen)) return;
      var b = document.createElement('button');
      b.className = 'kaartje' + (soort && soort.id === s.id ? ' on' : ''); b.type = 'button';
      b.innerHTML = '<b>' + s.naam + '</b><span>' + s.uitleg + '</span>';
      b.addEventListener('click', function(){
        soort = s;
        Array.prototype.forEach.call(soortVak.children, function(c){ c.classList.remove('on'); });
        b.classList.add('on');
        klaarCheck();
      });
      soortVak.appendChild(b);
    });
  }
  tekenSoorten();
  function klaarCheck(){ document.getElementById('startBtn').disabled = !(niveau && soort); }

  document.getElementById('startBtn').addEventListener('click', start);
  document.getElementById('nogeensBtn').addEventListener('click', function(){ naarStart(); });
  document.getElementById('opnieuwBtn').addEventListener('click', naarStart);
  document.getElementById('grootBtn').addEventListener('click', function(){
    document.body.classList.toggle('groot');
    this.textContent = document.body.classList.contains('groot') ? 'Normaal' : 'Digibord';
  });
  document.getElementById('bewaarBtn').addEventListener('click', bewaarScore);
  document.getElementById('naamveld').addEventListener('keydown', function(e){ if (e.key === 'Enter') bewaarScore(); });
  document.getElementById('wisBtn').addEventListener('click', function(){
    if (!confirm('Weet je zeker dat je het hele klassement van dit apparaat wist?')) return;
    schrijf({});
    toonKlassement('eindLijst', null);
  });

  function naarStart(){
    elSpel.classList.add('hide'); elEinde.classList.add('hide'); elStart.classList.remove('hide');
    toonKlassement('startLijst', null);
    scrollTo({top:0,behavior:'auto'});
  }

  /* ---------- de race ---------- */
  function start(){
    tijd = niveau.start; punten = 0; goed = 0; fout = 0; reeks = 0; besteReeks = 0;
    bezig = true; opgeslagen = false;
    elStart.classList.add('hide'); elEinde.classList.add('hide'); elSpel.classList.remove('hide');
    document.getElementById('naamvak').classList.remove('hide');
    volgendeSom();
    laatsteTik = performance.now();
    requestAnimationFrame(tik);
    scrollTo({top:0,behavior:'auto'});
  }

  function tik(nu){
    if (!bezig) return;
    var verstreken = (nu - laatsteTik) / 1000;
    laatsteTik = nu;
    tijd -= verstreken;
    if (tijd <= 0){ tijd = 0; tekenKlok(); stop(); return; }
    tekenKlok();
    requestAnimationFrame(tik);
  }

  function tekenKlok(){
    var deel = Math.max(0, Math.min(1, tijd / niveau.start));
    document.getElementById('tijdFill').style.width = (deel * 100) + '%';
    document.getElementById('tijdbalk').classList.toggle('krap', tijd <= 10);
    document.getElementById('klok').textContent = Math.ceil(tijd);
    document.getElementById('punten').textContent = punten;
    document.getElementById('goedTeller').textContent = goed;
  }

  function volgendeSom(){
    huidige = maakSom(niveau.id, soort.id);
    document.getElementById('vraag').textContent = huidige.vraag + ' =';
    document.getElementById('soortLabel').textContent = huidige.soort;
    var opties = maakOpties(huidige.antwoord);
    var vak = document.getElementById('opties');
    vak.innerHTML = '';
    opties.forEach(function(o, i){
      var b = document.createElement('button');
      b.className = 'optie'; b.type = 'button';
      b.innerHTML = '<kbd>' + (i + 1) + '</kbd>' + o;
      b.dataset.waarde = o;
      b.addEventListener('click', function(){ antwoord(o, b); });
      vak.appendChild(b);
    });
    document.getElementById('reeksTekst').innerHTML = reeks >= 3
      ? 'Je bent op dreef: <b>' + reeks + ' goed op rij</b>' + (reeks >= 5 ? ', punten tellen dubbel' : ', nog ' + (5 - reeks) + ' tot dubbele punten')
      : 'Vijf goed op rij levert dubbele punten op.';
  }

  function antwoord(gekozen, knop){
    if (!bezig) return;
    var klopt = gekozen === huidige.antwoord;
    Array.prototype.forEach.call(document.getElementById('opties').children, function(c){ c.disabled = true; });

    if (klopt){
      goed++; reeks++;
      besteReeks = Math.max(besteReeks, reeks);
      var basis = 10 + Math.round(Math.min(6, tijd / 8));
      var winst = reeks >= 5 ? basis * 2 : basis;
      punten += winst;
      tijd = Math.min(niveau.start * 1.6, tijd + niveau.erbij);
      knop.classList.add('goed');
      vlieg('+' + niveau.erbij + ' seconden', true);
    } else {
      fout++; reeks = 0;
      tijd -= niveau.eraf;
      knop.classList.add('fout');
      Array.prototype.forEach.call(document.getElementById('opties').children, function(c){
        if (Number(c.dataset.waarde) === huidige.antwoord) c.classList.add('goed');
      });
      vlieg('\u2212' + niveau.eraf + ' seconden', false);
    }
    tekenKlok();
    if (tijd <= 0){ stop(); return; }
    setTimeout(function(){ if (bezig) volgendeSom(); }, klopt ? 260 : 700);
  }

  function vlieg(tekst, positief){
    var v = document.getElementById('vlieger');
    v.textContent = tekst;
    v.className = 'vlieger ' + (positief ? 'op' : 'neer');
    void v.offsetWidth;
    v.classList.add('toon');
  }

  addEventListener('keydown', function(e){
    if (!bezig || elSpel.classList.contains('hide')) return;
    if (e.key < '1' || e.key > '4') return;
    var knop = document.getElementById('opties').children[parseInt(e.key, 10) - 1];
    if (knop && !knop.disabled) knop.click();
  });

  /* ---------- einde ---------- */
  function stop(){
    bezig = false;
    elSpel.classList.add('hide'); elEinde.classList.remove('hide');
    document.getElementById('eindPunten').textContent = punten + ' punten';
    var totaal = goed + fout;
    var deel = totaal ? Math.round(goed / totaal * 100) : 0;
    document.getElementById('eindTekst').textContent =
      'Je maakte ' + totaal + ' sommen, waarvan ' + goed + ' goed (' + deel + ' procent). ' +
      'Je langste reeks was ' + besteReeks + '.';
    document.getElementById('samenvatting').innerHTML =
      '<div class="sam"><i>Goed</i><b>' + goed + '</b></div>' +
      '<div class="sam"><i>Fout</i><b>' + fout + '</b></div>' +
      '<div class="sam"><i>Langste reeks</i><b>' + besteReeks + '</b></div>' +
      '<div class="sam"><i>Niveau</i><b style="font-size:.95rem">' + niveau.naam + '</b></div>';
    var veld = document.getElementById('naamveld');
    veld.value = ''; veld.focus();
    toonKlassement('eindLijst', null);
    document.getElementById('opslaghint').textContent = opslagWerkt()
      ? 'Het klassement staat op dit apparaat, dus in deze browser. Op een klascomputer of digibord zien jullie dus dezelfde lijst.'
      : 'Deze browser staat opslaan niet toe, dus je score kan niet in het klassement.';
    scrollTo({top:0,behavior:'smooth'});
  }

  function bewaarScore(){
    if (opgeslagen) return;
    var naam = document.getElementById('naamveld').value.trim().slice(0, 14);
    if (!naam){ document.getElementById('naamveld').focus(); return; }
    var data = lees();
    var sleutel = niveau.id + '-' + soort.id;
    var lijst = data[sleutel] || [];
    var nieuw = { naam:naam, punten:punten, goed:goed, reeks:besteReeks, datum:new Date().toLocaleDateString('nl-NL') };
    lijst.push(nieuw);
    lijst.sort(function(a, b){ return b.punten - a.punten; });
    lijst = lijst.slice(0, 10);
    data[sleutel] = lijst;
    var gelukt = schrijf(data);
    opgeslagen = true;
    document.getElementById('naamvak').classList.add('hide');
    toonKlassement('eindLijst', gelukt ? nieuw : null);
    if (!gelukt) document.getElementById('opslaghint').textContent = 'Opslaan lukte niet in deze browser, je score staat dus niet in de lijst.';
  }

  function toonKlassement(doelId, markeer){
    var doel = document.getElementById(doelId);
    if (!doel) return;
    if (!niveau || !soort){ doel.innerHTML = ''; return; }
    var data = lees();
    var lijst = data[niveau.id + '-' + soort.id] || [];
    var titel = 'Klassement ' + niveau.naam + ', ' + soort.naam.toLowerCase();
    if (!lijst.length){
      doel.innerHTML = '<h3>' + titel + '</h3><div class="leeg">Nog geen scores. Wie het eerst speelt, staat bovenaan.</div>';
      return;
    }
    var html = '<h3>' + titel + '</h3>';
    lijst.forEach(function(r, i){
      var ik = markeer && r.naam === markeer.naam && r.punten === markeer.punten;
      html += '<div class="plek' + (ik ? ' jij' : '') + '"><span class="nr">' + (i + 1) + '</span>' +
        '<span><b>' + r.naam + '</b><small>' + r.goed + ' goed &middot; reeks ' + r.reeks + ' &middot; ' + r.datum + '</small></span>' +
        '<span class="pt">' + r.punten + '</span></div>';
    });
    doel.innerHTML = html;
  }

  /* ------------------------------------------------------------------
     Deelbare link vanuit de leerlingomgeving: ?n=bb, ?n=kgt of ?n=hv.
     Met ?s=tafels kies je ook het onderdeel al voor.
     ------------------------------------------------------------------ */
  (function(){
    function param(naam){
      var m = new RegExp('[?&]' + naam + '=([^&]+)').exec(location.search);
      return m ? decodeURIComponent(m[1]) : null;
    }
    var n = param('n');
    if (n) for (var i = 0; i < NIVEAUS.length; i++){
      if (NIVEAUS[i].id === n){
        nivVak.children[i].click();
        nivVak.style.display = 'none';
        var kop = document.getElementById('nivKop');
        if (kop) kop.textContent = 'Niveau: ' + NIVEAUS[i].naam + ', gekozen door je docent';
      }
    }
    var s = param('s');
    if (s) Array.prototype.forEach.call(soortVak.children, function(knop, k){
      var zichtbaar = SOORTEN.filter(function(x){ return !x.alleen || (niveau && x.alleen === niveau.id); });
      if (zichtbaar[k] && zichtbaar[k].id === s) knop.click();
    });
  })();

  /* De knop linksboven gaat terug naar het spellenmenu, met je niveau erbij. */
  (function(){
    var m = document.querySelector('header .mark');
    if (m) m.setAttribute('href', './' + location.search);
  })();
})();
</script>
